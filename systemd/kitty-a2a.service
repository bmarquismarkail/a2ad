[Unit]
Description=kitty-a2a daemon (a2ad) — A2A agent orchestrator for Kitty terminals
Documentation=file:///home/brandon/src/projects/a2ad/DESIGN.md
# Start after the user session is fully up (so XDG_RUNTIME_DIR is set).
After=default.target

[Service]
Type=simple
# User is filled in at install time: systemd --user units run as the invoking
# user by default, but we set it explicitly for clarity.
# Type=simple requires a2ad to remain in the foreground. Without this flag the
# daemon double-forks, the tracked parent exits, and systemd tears down the
# service cgroup as soon as startup appears to finish.
ExecStart=/usr/local/bin/a2ad --foreground --config %h/.config/kitty-a2a/agents.yaml
# Configure periodic polling with ipc.reconcile_interval_sec in agents.yaml.
Restart=on-failure
RestartSec=2

# Hardening (best-effort; adjust to taste).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# SQLite state is the sole writable home-directory path. Keep the rest of the
# home tree read-only while allowing a2ad to update its task registry.
ReadWritePaths=%h/.local/state/kitty-a2a
# Let systemd create the same directory selected by Paths::resolve() under
# XDG_RUNTIME_DIR and keep the socket writable inside the service namespace.
RuntimeDirectory=kitty-a2a
RuntimeDirectoryMode=0700
ReadWritePaths=%t/kitty-a2a

[Install]
WantedBy=default.target
